{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "family", "requirement", "description", "actions"],
  "properties": {
    "schema_version": {"const": 1},
    "family": {"const": "uniswap-v4-rebate-v1"},
    "requirement": {"enum": ["R1", "R2", "R3", "R4", "R5"]},
    "description": {"type": "string", "maxLength": 2000},
    "actions": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {"oneOf": [
        {"type": "object", "additionalProperties": false,
         "required": ["op", "pool", "amount"],
         "properties": {"op": {"enum": ["swap", "claim"]}, "pool": {"enum": ["A", "B"]},
                        "amount": {"type": "integer", "minimum": 1, "maximum": 1000000000000}}},
        {"type": "object", "additionalProperties": false,
         "required": ["op", "target", "caller", "calldata"],
         "properties": {"op": {"const": "call"},
                        "target": {"enum": ["hook", "router", "manager", "currency0", "currency1"]},
                        "caller": {"enum": ["self", "bob"]},
                        "calldata": {"type": "string", "pattern": "^0x([0-9a-fA-F]{2}){0,2048}$"}}}
      ]}
    }
  }
}
